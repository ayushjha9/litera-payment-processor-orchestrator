<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The reasoning in these doc comments is the substance of the exercise, not decoration. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 would demand a comment on every self-evident enum member and property.
         The comments that carry the "why" are written where they earn their place. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
